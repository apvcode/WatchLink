<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_0">

    <FrameLayout android:id="@+id/mainLayout" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/contentContainer" android:layout_width="match_parent" android:layout_height="240dp" android:visibility="gone">
            <WebView android:id="@+id/contentWebView" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <WebView android:id="@+id/uiWebView" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Fullscreen Video Container for WebChromeClient custom view -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
